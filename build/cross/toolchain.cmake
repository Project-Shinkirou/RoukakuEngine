file(STRINGS /opt/apple/target RUST_TARGET)
set(CMAKE_C_COMPILER /opt/apple/bin/apple-cc)
set(CMAKE_CXX_COMPILER /opt/apple/bin/apple-cxx)
set(CMAKE_AR /opt/apple/bin/apple-ar)
set(CMAKE_RANLIB /usr/bin/llvm-ranlib)
get_filename_component(APPLE_SDK_REALPATH /opt/apple-sdk REALPATH)
set(CMAKE_OSX_SYSROOT "${APPLE_SDK_REALPATH}" CACHE PATH "Locally supplied Apple SDK")
if(RUST_TARGET MATCHES "darwin$")
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_OSX_DEPLOYMENT_TARGET 13.0 CACHE STRING "Minimum macOS")
else()
  set(CMAKE_SYSTEM_NAME iOS)
  set(CMAKE_OSX_DEPLOYMENT_TARGET 16.0 CACHE STRING "Minimum iOS")
endif()
if(RUST_TARGET MATCHES "^aarch64")
  set(CMAKE_SYSTEM_PROCESSOR arm64)
  set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Target architecture")
else()
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
  set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "Target architecture")
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH /opt/apple-sdk)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
