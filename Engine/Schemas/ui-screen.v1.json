{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-shinkirou.github.io/schemas/ui-screen.v1.json",
  "title": "Roukaku UI screens v1",
  "type": "object",
  "required": [
    "$schema"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "(^|/)ui-screen\\.v1\\.json$"
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "view",
          "controller",
          "policy",
          "theme"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "system_page": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "view": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "controller": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "theme": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "command"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "surface"
                  ]
                },
                {
                  "required": [
                    "system_page"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "surface"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "system_page"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "system_page"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "surface"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "profile"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "surface"
                  ]
                },
                {
                  "required": [
                    "system_page"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile",
          "save_slots",
          "allowed_pages",
          "reading_modes",
          "audio_toggle",
          "save_completion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "save_slots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "quick_slot": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed_pages": {
            "type": "array",
            "items": {
              "enum": [
                "title",
                "quick_panel",
                "save",
                "load",
                "config",
                "backlog",
                "gallery",
                "replay",
                "voice_replay",
                "route_chart",
                "localization_preview",
                "custom"
              ]
            },
            "uniqueItems": true
          },
          "reading_modes": {
            "type": "array",
            "items": {
              "enum": [
                "hidden",
                "manual",
                "fast_forward"
              ]
            },
            "contains": {
              "const": "manual"
            },
            "uniqueItems": true
          },
          "audio_toggle": {
            "type": "boolean"
          },
          "save_completion": {
            "enum": [
              "stay",
              "return_system"
            ]
          },
          "custom_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "control": {
      "type": "object",
      "required": [
