{
  "$schema": "https://project-shinkirou.github.io/schemas/ui-screen.v1.json",
  "views": [
    {
      "id": "ui.message.classic",
      "source_id": "ui.message.classic",
      "model": "roukaku.vn.ui_model.message.v2",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.clear",
        "children": [
          {
            "id": "advance",
            "kind": "panel",
            "source_id": "UI/flagship.roukaku/advance",
            "fill": true,
            "events": [
              {
                "event": "activate",
                "action": "vn.advance"
              }
            ]
          },
          {
            "id": "message_panel",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/message_panel",
            "background": "theme:panel.message",
            "min_height": 260,
            "fill_width": true,
            "anchor": "bottom",
            "children": [
              {
                "id": "speaker",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/speaker",
                "value": "$model.speaker_key",
                "font_size": 24,
                "max_lines": 1
              },
              {
                "id": "body",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/body",
                "value": "$model.text_key",
                "visible_graphemes": "$model.visible_graphemes",
                "font_size": 30,
                "max_lines": 5
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.choice.classic",
      "source_id": "ui.choice.classic",
      "model": "roukaku.vn.ui_model.choice.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.dim",
        "children": [
          {
            "id": "choices",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/choices",
            "background": "theme:panel.message",
            "children": [
              {
                "id": "prompt",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/prompt",
                "value": "$model.prompt_key"
              },
              {
                "id": "options",
                "kind": "virtual_list",
                "source_id": "UI/flagship.roukaku/options",
                "items": "$model.options",
                "item_key": "option_id",
                "overscan": 2,
                "item_extent": 64,
                "children": [
                  {
                    "id": "option",
                    "kind": "button",
                    "source_id": "UI/flagship.roukaku/option",
                    "min_height": 60,
                    "value": "$item.text_key",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.choose",
                        "arguments": {
                          "option_id": "$item.option_id"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.title",
      "source_id": "ui.system.title",
      "model": "roukaku.vn.ui_model.title.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "backdrop",
            "kind": "image",
            "source_id": "UI/flagship.roukaku/backdrop",
            "asset": "theme:system.backdrop",
            "min_width": 1280,
            "min_height": 720
          },
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "title",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/title",
                "value": "l10n:system.title"
              },
              {
                "id": "new_game",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/new_game",
                "min_height": 56,
                "text": "l10n:system.new_game",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.invoke_system_action",
                    "arguments": {
                      "action_id": "nativevn.story.start"
                    }
                  }
                ]
              },
              {
                "id": "experience",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/experience",
                "min_height": 56,
                "text": "l10n:system.experience",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.invoke_system_action",
                    "arguments": {
                      "action_id": "nativevn.experience.open"
                    }
                  }
                ]
              },
              {
                "id": "continue",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/continue",
                "min_height": 56,
                "text": "l10n:system.continue",
                "enabled": "$model.can_continue",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              },
              {
                "id": "config",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/config",
                "min_height": 56,
                "text": "l10n:system.config",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.open_system",
                    "arguments": {
                      "page": "config"
                    }
                  }
                ]
              },
              {
                "id": "save",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/save",
                "min_height": 56,
                "text": "l10n:system.save",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.open_system",
                    "arguments": {
                      "page": "save"
                    }
                  }
                ]
              },
              {
                "id": "load",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/load",
                "min_height": 56,
                "text": "l10n:system.load",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.open_system",
                    "arguments": {
                      "page": "load"
                    }
                  }
                ]
              },
              {
                "id": "back",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/back",
                "min_height": 56,
                "text": "l10n:system.back",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.save",
      "source_id": "ui.system.save",
      "model": "roukaku.vn.ui_model.save.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "slots",
                "kind": "virtual_grid",
                "source_id": "UI/flagship.roukaku/slots",
                "items": "$model.slots",
                "item_key": "slot_id",
                "columns": 3,
                "overscan": 2,
                "item_extent": 320,
                "viewport_extent": 640,
                "min_height": 640,
                "max_height": 640,
                "fill_width": true,
                "clip_children": true,
                "children": [
                  {
                    "id": "slot",
                    "kind": "column",
                    "source_id": "UI/flagship.roukaku/slot",
                    "min_height": 320,
                    "background": "theme:panel.button",
                    "children": [
                      {
                        "id": "thumbnail",
                        "kind": "image",
                        "source_id": "UI/flagship.roukaku/thumbnail",
                        "asset": "$item.thumbnail_asset",
                        "visible": "$item.has_thumbnail",
                        "min_width": 280,
                        "max_width": 400,
                        "min_height": 120,
                        "max_height": 120
                      },
                      {
                        "id": "slot_id",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/slot_id",
                        "value": "$item.slot_id"
                      },
                      {
                        "id": "title",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/title",
                        "value": "$item.title_key"
                      },
                      {
                        "id": "timestamp",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/timestamp",
                        "value": "$item.timestamp_text"
                      },
                      {
                        "id": "playtime",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/playtime",
                        "value": "$item.playtime_text"
                      },
                      {
                        "id": "write",
                        "kind": "button",
                        "source_id": "UI/flagship.roukaku/write",
                        "min_height": 48,
                        "text": "l10n:system.save",
                        "enabled": "$item.can_write",
                        "events": [
                          {
                            "event": "activate",
                            "action": "vn.request_save",
                            "arguments": {
                              "slot_id": "$item.slot_id"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "back",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/back",
                "min_height": 56,
                "text": "l10n:system.back",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.load",
      "source_id": "ui.system.load",
      "model": "roukaku.vn.ui_model.load.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "slots",
                "kind": "virtual_grid",
                "source_id": "UI/flagship.roukaku/slots",
                "items": "$model.slots",
                "item_key": "slot_id",
                "columns": 3,
                "overscan": 2,
                "item_extent": 320,
                "viewport_extent": 640,
                "min_height": 640,
                "max_height": 640,
                "fill_width": true,
                "clip_children": true,
                "children": [
                  {
                    "id": "slot",
                    "kind": "column",
                    "source_id": "UI/flagship.roukaku/slot",
                    "min_height": 320,
                    "background": "theme:panel.button",
                    "children": [
                      {
                        "id": "thumbnail",
                        "kind": "image",
                        "source_id": "UI/flagship.roukaku/thumbnail",
                        "asset": "$item.thumbnail_asset",
                        "visible": "$item.has_thumbnail",
                        "min_width": 280,
                        "max_width": 400,
                        "min_height": 120,
                        "max_height": 120
                      },
                      {
                        "id": "slot_id",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/slot_id",
                        "value": "$item.slot_id"
                      },
                      {
                        "id": "title",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/title",
                        "value": "$item.title_key"
                      },
                      {
                        "id": "timestamp",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/timestamp",
                        "value": "$item.timestamp_text"
                      },
                      {
                        "id": "playtime",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/playtime",
                        "value": "$item.playtime_text"
                      },
                      {
                        "id": "read",
                        "kind": "button",
                        "source_id": "UI/flagship.roukaku/read",
                        "min_height": 48,
                        "text": "l10n:system.load",
                        "enabled": "$item.can_load",
                        "events": [
                          {
                            "event": "activate",
                            "action": "vn.request_load",
                            "arguments": {
                              "slot_id": "$item.slot_id"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "back",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/back",
                "min_height": 56,
                "text": "l10n:system.back",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.config",
      "source_id": "ui.system.config",
      "model": "roukaku.vn.ui_model.config.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "title",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/title",
                "value": "l10n:system.config"
              },
              {
                "id": "master_label",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/master_label",
                "value": "l10n:system.config.master_volume"
              },
              {
                "id": "master",
                "kind": "slider",
                "source_id": "UI/flagship.roukaku/master",
                "min_height": 56,
                "value": "$model.master_volume",
                "min": 0,
                "max": 100,
                "step": 1,
                "events": [
                  {
                    "event": "change",
                    "action": "vn.set_config",
                    "arguments": {
                      "key": "audio.master",
                      "value": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "speed_label",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/speed_label",
                "value": "l10n:system.config.text_speed"
              },
              {
                "id": "text_speed",
                "kind": "slider",
                "source_id": "UI/flagship.roukaku/text_speed",
                "min_height": 56,
                "value": "$model.text_speed",
                "min": 0,
                "max": 100,
                "step": 1,
                "events": [
                  {
                    "event": "change",
                    "action": "vn.set_config",
                    "arguments": {
                      "key": "text.speed",
                      "value": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "auto_label",
                "kind": "text",
                "source_id": "UI/flagship.roukaku/auto_label",
                "value": "l10n:system.config.auto_delay"
              },
              {
                "id": "auto_delay",
                "kind": "slider",
                "source_id": "UI/flagship.roukaku/auto_delay",
                "min_height": 56,
                "value": "$model.auto_delay_ms",
                "min": 100,
                "max": 10000,
                "step": 100,
                "events": [
                  {
                    "event": "change",
                    "action": "vn.set_config",
                    "arguments": {
                      "key": "auto.delay_ms",
                      "value": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "high_contrast",
                "kind": "toggle",
                "source_id": "UI/flagship.roukaku/high_contrast",
                "min_height": 56,
                "value": "$model.high_contrast",
                "label_key": "l10n:system.config.high_contrast",
                "events": [
                  {
                    "event": "change",
                    "action": "vn.set_config",
                    "arguments": {
                      "key": "display.high_contrast",
                      "value": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "locale",
                "kind": "select",
                "source_id": "UI/flagship.roukaku/locale",
                "min_height": 56,
                "value": "$model.locale",
                "items": "$model.available_locales",
                "events": [
                  {
                    "event": "change",
                    "action": "vn.set_config",
                    "arguments": {
                      "key": "display.language",
                      "value": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "player_name",
                "kind": "text_input",
                "source_id": "UI/flagship.roukaku/player_name",
                "min_height": 56,
                "value": "$model.player_name.value",
                "multiline": "$model.player_name.multiline",
                "max_graphemes": "$model.player_name.max_graphemes",
                "character_policy": "$model.player_name.character_policy",
                "events": [
                  {
                    "event": "submit",
                    "action": "vn.submit_text",
                    "arguments": {
                      "input_id": "$model.player_name.input_id",
                      "value": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "back",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/back",
                "min_height": 56,
                "text": "l10n:system.back",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.backlog",
      "source_id": "ui.system.backlog",
      "model": "roukaku.vn.ui_model.backlog.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "entries",
                "kind": "virtual_list",
                "source_id": "UI/flagship.roukaku/entries",
                "items": "$model.entries",
                "item_key": "command_id",
                "overscan": 8,
                "item_extent": 72,
                "children": [
                  {
                    "id": "entry",
                    "kind": "row",
                    "source_id": "UI/flagship.roukaku/entry",
                    "min_height": 68,
                    "children": [
                      {
                        "id": "speaker",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/speaker",
                        "value": "$item.speaker_key"
                      },
                      {
                        "id": "body",
                        "kind": "text",
                        "source_id": "UI/flagship.roukaku/body",
                        "value": "$item.text_key"
                      },
                      {
                        "id": "voice",
                        "kind": "button",
                        "source_id": "UI/flagship.roukaku/voice",
                        "min_width": 96,
                        "visible": "$item.has_voice",
                        "events": [
                          {
                            "event": "activate",
                            "action": "vn.replay_voice",
                            "arguments": {
                              "voice_id": "$item.voice_id"
                            }
                          }
                        ]
                      },
                      {
                        "id": "jump",
                        "kind": "button",
                        "source_id": "UI/flagship.roukaku/jump",
                        "min_width": 96,
                        "visible": "$item.can_jump",
                        "events": [
                          {
                            "event": "activate",
                            "action": "vn.request_backlog_jump",
                            "arguments": {
                              "command_id": "$item.command_id"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "back",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/back",
                "min_height": 56,
                "text": "l10n:system.back",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.gallery",
      "source_id": "ui.system.gallery",
      "model": "roukaku.vn.ui_model.gallery.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "items",
                "kind": "virtual_grid",
                "source_id": "UI/flagship.roukaku/items",
                "items": "$model.items",
                "item_key": "item_id",
                "columns": 4,
                "overscan": 2,
                "item_extent": 180,
                "children": [
                  {
                    "id": "item",
                    "kind": "column",
                    "source_id": "UI/flagship.roukaku/item",
                    "min_height": 168,
                    "background": "theme:panel.button",
                    "children": [
                      {
                        "id": "thumbnail",
                        "kind": "image",
                        "source_id": "UI/flagship.roukaku/thumbnail",
                        "asset": "$item.thumbnail_asset",
                        "visible": "$item.has_thumbnail",
                        "min_width": 240,
                        "min_height": 112
                      },
                      {
                        "id": "preview",
                        "kind": "button",
                        "source_id": "UI/flagship.roukaku/preview",
                        "min_height": 52,
                        "value": "$item.label_key",
                        "enabled": "$item.unlocked",
                        "events": [
                          {
                            "event": "activate",
                            "action": "vn.preview_gallery",
                            "arguments": {
                              "item_id": "$item.item_id"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "back",
                "kind": "button",
                "source_id": "UI/flagship.roukaku/back",
                "min_height": 56,
                "text": "l10n:system.back",
                "events": [
                  {
                    "event": "activate",
                    "action": "vn.return_system"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.system.replay",
      "source_id": "ui.system.replay",
      "model": "roukaku.vn.ui_model.replay.v1",
      "theme": "roukaku.vn.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/flagship.roukaku/root",
        "background": "theme:surface.system",
        "children": [
          {
            "id": "content",
            "kind": "column",
            "source_id": "UI/flagship.roukaku/content",
            "children": [
              {
                "id": "items",
                "kind": "virtual_list",
                "source_id": "UI/flagship.roukaku/items",
                "items": "$model.items",
                "item_key": "item_id",
                "overscan": 4,
                "item_extent": 64,
                "children": [
                  {
                    "id": "item",
                    "kind": "button",
                    "source_id": "UI/flagship.roukaku/item",
                    "min_height": 60,
                    "value": "$item.label_key",
                    "events": [
                      {
