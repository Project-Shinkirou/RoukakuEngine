{
  "$schema": "https://project-shinkirou.github.io/schemas/ui-style.v1.json",
  "$id": "roukaku.vn.theme.classic",
  ":root": {
    "surface.clear": {
      "color": [
        0,
        0,
        0,
        0
      ]
    },
    "surface.dim": {
      "color": [
        8,
        12,
        22,
        180
      ]
    },
    "surface.system": {
      "color": [
        12,
        18,
        30,
        252
      ]
    },
    "panel.message": {
      "color": [
        18,
        22,
        34,
        236
      ]
    },
    "panel.button": {
      "color": [
        38,
        58,
        84,
        255
      ]
    },
    "system.backdrop": {
      "asset": "asset:/key-art/title-background"
    },
    "text.body": {
      "color": [
        245,
        245,
        248,
        255
      ]
    }
  },
  ":high-contrast": {
    "surface.system": {
      "color": [
        0,
        0,
        0,
        255
      ]
    },
    "text.body": {
      "color": [
        255,
        255,
        255,
        255
      ]
    }
  }
}
