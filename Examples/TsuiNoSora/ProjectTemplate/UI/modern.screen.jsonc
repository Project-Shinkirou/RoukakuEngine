{
  "$schema": "https://project-shinkirou.github.io/schemas/ui-screen.v1.json",
  "views": [
    {
      "id": "ui.tsui.modern.message",
      "source_id": "ui.tsui.modern.message",
      "model": "roukaku.vn.ui_model.message.v2",
      "theme": "tsui.theme.modern",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/modern.roukaku/root",
        "children": [
          {
            "id": "advance",
            "kind": "panel",
            "source_id": "UI/modern.roukaku/advance",
            "fill": true,
            "events": [
              {
                "event": "activate",
                "action": "vn.advance"
              }
            ]
          },
          {
            "id": "dialogue_frame",
            "kind": "image",
            "source_id": "UI/modern.roukaku/dialogue_frame",
            "asset": "theme:dialogue.frame",
            "min_width": 754,
            "min_height": 82,
            "position_x": 23,
            "position_y": 483
          },
          {
            "id": "dialogue",
            "kind": "row",
            "source_id": "UI/modern.roukaku/dialogue",
            "position_x": 56,
            "position_y": 484,
            "min_width": 688,
            "max_width": 688,
            "max_height": 80,
            "gap": 18,
            "clip_children": true,
            "children": [
              {
                "id": "speaker_text",
                "kind": "text",
                "source_id": "UI/modern.roukaku/speaker_text",
                "value": "$model.speaker_key",
                "min_width": 92,
                "max_width": 92,
                "max_height": 72,
                "font_size": 20,
                "max_lines": 2
              },
              {
                "id": "body_scroll",
                "kind": "scroll",
                "source_id": "UI/modern.roukaku/body_scroll",
                "min_width": 578,
                "max_width": 578,
                "min_height": 72,
                "max_height": 72,
                "clip_children": true,
                "children": [
                  {
                    "id": "body",
                    "kind": "text",
                    "source_id": "UI/modern.roukaku/body",
                    "value": "$model.text_key",
                    "visible_graphemes": "$model.visible_graphemes",
                    "max_width": 562,
                    "font_size": 22,
                    "max_lines": 64,
                    "text_padding": 0
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.tsui.modern.monologue",
      "source_id": "ui.tsui.modern.monologue",
      "model": "roukaku.vn.ui_model.message.v2",
      "theme": "tsui.theme.modern",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/modern.roukaku/root",
        "children": [
          {
            "id": "advance",
            "kind": "panel",
            "source_id": "UI/modern.roukaku/advance",
            "fill": true,
            "events": [
              {
                "event": "activate",
                "action": "vn.advance"
              }
            ]
          },
          {
            "id": "body",
            "kind": "text",
            "source_id": "UI/modern.roukaku/body",
            "value": "$model.text_key",
            "visible_graphemes": "$model.visible_graphemes",
            "position_x": 23,
            "position_y": 42,
            "min_width": 754,
            "min_height": 424,
            "font_size": 22,
            "max_lines": 20,
            "text_align": "center",
            "vertical_align": "center",
            "text_color": "theme:text.monologue"
          }
        ]
      }
    },
    {
      "id": "ui.tsui.modern.choice",
      "source_id": "ui.tsui.modern.choice",
      "model": "roukaku.vn.ui_model.choice.v1",
      "theme": "tsui.theme.modern",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/modern.roukaku/root",
        "children": [
          {
            "id": "gold",
            "kind": "column",
            "source_id": "UI/modern.roukaku/gold",
            "anchor": "center",
            "background": "theme:accent.gold",
            "min_width": 604,
            "padding": 2,
            "children": [
              {
                "id": "choices",
                "kind": "column",
                "source_id": "UI/modern.roukaku/choices",
                "background": "theme:surface.paper",
                "min_width": 600,
                "padding": 20,
                "gap": 10,
                "children": [
                  {
                    "id": "prompt",
                    "kind": "text",
                    "source_id": "UI/modern.roukaku/prompt",
                    "value": "$model.prompt_key",
                    "font_size": 22
                  },
                  {
                    "id": "options",
                    "kind": "virtual_list",
                    "source_id": "UI/modern.roukaku/options",
                    "items": "$model.options",
                    "item_key": "option_id",
                    "overscan": 2,
                    "item_extent": 56,
                    "gap": 8,
                    "children": [
                      {
                        "id": "option",
                        "kind": "button",
                        "source_id": "UI/modern.roukaku/option",
                        "min_height": 48,
                        "value": "$item.text_key",
                        "enabled": "$item.enabled",
                        "background": "theme:surface.button",
                        "text_color": "theme:text.on_dark",
                        "events": [
                          {
                            "event": "activate",
                            "action": "vn.choose",
                            "arguments": {
                              "option_id": "$item.option_id"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.tsui.modern.quick_panel",
      "source_id": "ui.tsui.modern.quick_panel",
      "model": "roukaku.vn.ui_model.quick_panel.v1",
      "theme": "tsui.theme.modern",
      "root": {
        "id": "root",
        "kind": "modal",
        "source_id": "UI/modern.roukaku/root",
        "background": "theme:surface.dim",
        "children": [
          {
            "id": "gold",
            "kind": "column",
            "source_id": "UI/modern.roukaku/gold",
            "anchor": "center",
            "background": "theme:accent.gold",
            "min_width": 754,
            "padding": 2,
            "children": [
              {
                "id": "commands",
                "kind": "row",
                "source_id": "UI/modern.roukaku/commands",
                "background": "theme:surface.paper",
                "min_width": 750,
                "min_height": 72,
                "padding": 10,
                "gap": 5,
                "children": [
                  {
                    "id": "save",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/save",
                    "text": "l10n:system.save",
                    "min_width": 94,
                    "background": "theme:surface.button",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.open_system",
                        "arguments": {
                          "page": "save"
                        }
                      }
                    ]
                  },
                  {
                    "id": "load",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/load",
                    "text": "l10n:system.load",
                    "min_width": 94,
                    "background": "theme:surface.button",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.open_system",
                        "arguments": {
                          "page": "load"
                        }
                      }
                    ]
                  },
                  {
                    "id": "backlog",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/backlog",
                    "text": "l10n:system.backlog",
                    "min_width": 104,
                    "background": "theme:surface.button",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.open_system",
                        "arguments": {
                          "page": "backlog"
                        }
                      }
                    ]
                  },
                  {
                    "id": "auto",
                    "kind": "toggle",
                    "source_id": "UI/modern.roukaku/auto",
                    "label_key": "l10n:system.auto",
                    "value": "$model.auto_enabled",
                    "min_width": 104,
                    "background": "theme:surface.button_alt",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "change",
                        "action": "vn.set_auto",
                        "arguments": {
                          "enabled": "$event.value"
                        }
                      }
                    ]
                  },
                  {
                    "id": "skip_all",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/skip_all",
                    "text": "l10n:system.skip_all",
                    "min_width": 94,
                    "background": "theme:surface.button",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.set_skip",
                        "arguments": {
                          "mode": "all"
                        }
                      }
                    ]
                  },
                  {
                    "id": "config",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/config",
                    "text": "l10n:system.config",
                    "min_width": 104,
                    "background": "theme:surface.button",
