            "min_width": 800,
            "min_height": 600
          },
          {
            "id": "gold",
            "kind": "column",
            "source_id": "UI/modern.roukaku/gold",
            "position_x": 23,
            "position_y": 29,
            "position_right": 23,
            "position_bottom": 29,
            "background": "theme:accent.gold",
            "min_width": 754,
            "min_height": 542,
            "padding": 2,
            "children": [
              {
                "id": "content",
                "kind": "column",
                "source_id": "UI/modern.roukaku/content",
                "background": "theme:surface.paper",
                "min_width": 714,
                "min_height": 484,
                "padding": 18,
                "gap": 10,
                "children": [
                  {
                    "id": "title",
                    "kind": "text",
                    "source_id": "UI/modern.roukaku/title",
                    "value": "l10n:system.save",
                    "font_size": 26
                  },
                  {
                    "id": "slots",
                    "kind": "virtual_grid",
                    "source_id": "UI/modern.roukaku/slots",
                    "items": "$model.slots",
                    "item_key": "slot_id",
                    "columns": 3,
                    "overscan": 0,
                    "item_extent": 196,
                    "viewport_extent": 390,
                    "min_height": 390,
                    "gap": 8,
                    "children": [
                      {
                        "id": "slot",
                        "kind": "column",
                        "source_id": "UI/modern.roukaku/slot",
                        "background": "theme:surface.card",
                        "min_width": 226,
                        "min_height": 184,
                        "padding": 6,
                        "gap": 1,
                        "children": [
                          {
                            "id": "preview",
                            "kind": "stack",
                            "source_id": "UI/modern.roukaku/preview",
                            "min_width": 214,
                            "min_height": 64,
                            "children": [
                              {
                                "id": "empty_preview",
                                "kind": "image",
                                "source_id": "UI/modern.roukaku/empty_preview",
                                "asset": "theme:sky.frame",
                                "min_width": 214,
                                "min_height": 64
                              },
                              {
                                "id": "thumbnail",
                                "kind": "image",
                                "source_id": "UI/modern.roukaku/thumbnail",
                                "asset": "$item.thumbnail_asset",
                                "visible": "$item.has_thumbnail",
                                "min_width": 214,
                                "min_height": 64
                              }
                            ]
                          },
                          {
                            "id": "number",
                            "kind": "text",
                            "source_id": "UI/modern.roukaku/number",
                            "value": "$item.slot_id",
                            "font_size": 16,
                            "max_lines": 1
                          },
                          {
                            "id": "metadata",
                            "kind": "text",
                            "source_id": "UI/modern.roukaku/metadata",
                            "value": "$item.metadata_text",
                            "font_size": 12,
                            "max_lines": 1
                          },
                          {
                            "id": "write",
                            "kind": "button",
                            "source_id": "UI/modern.roukaku/write",
                            "value": "$item.slot_id",
                            "enabled": "$item.can_write",
                            "min_height": 32,
                            "background": "theme:surface.button",
                            "text_color": "theme:text.on_dark",
                            "events": [
                              {
                                "event": "activate",
                                "action": "vn.request_save",
                                "arguments": {
                                  "slot_id": "$item.slot_id"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "back",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/back",
                    "text": "l10n:system.back",
                    "min_height": 42,
                    "background": "theme:surface.button_alt",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.return_system"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
