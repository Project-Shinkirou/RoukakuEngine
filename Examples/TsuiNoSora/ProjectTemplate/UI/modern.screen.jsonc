    {
      "id": "ui.tsui.modern.save",
      "source_id": "ui.tsui.modern.save",
      "model": "roukaku.vn.ui_model.save.v1",
      "theme": "tsui.theme.modern",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/modern.roukaku/root",
        "background": "theme:surface.sky",
        "children": [
          {
            "id": "sky_frame",
