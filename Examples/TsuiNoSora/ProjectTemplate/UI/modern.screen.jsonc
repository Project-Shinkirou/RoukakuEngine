                            "kind": "button",
                            "source_id": "UI/modern.roukaku/read",
                            "value": "$item.slot_id",
                            "enabled": "$item.can_load",
                            "min_height": 32,
                            "background": "theme:surface.button",
                            "text_color": "theme:text.on_dark",
                            "events": [
                              {
                                "event": "activate",
                                "action": "vn.request_load",
                                "arguments": {
                                  "slot_id": "$item.slot_id"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "back",
                    "kind": "button",
                    "source_id": "UI/modern.roukaku/back",
                    "text": "l10n:system.back",
                    "min_height": 42,
                    "background": "theme:surface.button_alt",
                    "text_color": "theme:text.on_dark",
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.return_system"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
