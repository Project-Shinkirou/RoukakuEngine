    {
      "id": "ui.tsui.classic.choice",
      "source_id": "ui.tsui.classic.choice",
      "model": "roukaku.vn.ui_model.choice.v1",
      "theme": "tsui.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/classic.roukaku/root",
        "children": [
          {
            "id": "choices",
            "kind": "column",
            "source_id": "UI/classic.roukaku/choices",
            "position_x": 153,
            "position_y": 110,
            "min_width": 300,
            "max_width": 300,
            "gap": 4,
            "children": [
              {
                "id": "options",
                "kind": "virtual_list",
                "source_id": "UI/classic.roukaku/options",
                "items": "$model.options",
                "item_key": "option_id",
                "overscan": 2,
                "item_extent": 40,
                "gap": 1,
                "children": [
                  {
                    "id": "option",
                    "kind": "button",
                    "source_id": "UI/classic.roukaku/option",
                    "min_width": 300,
                    "max_width": 300,
                    "min_height": 40,
                    "max_height": 40,
                    "padding": 0,
                    "background": "theme:surface.clear",
                    "text_color": "theme:text.system",
                    "children": [
                      {
                        "id": "line",
                        "kind": "row",
                        "source_id": "UI/classic.roukaku/line",
                        "min_width": 300,
                        "max_width": 300,
                        "gap": 0,
                        "children": [
                          {
                            "id": "diamond",
                            "kind": "text",
                            "source_id": "UI/classic.roukaku/diamond",
                            "text": "◆",
                            "font_size": 22,
                            "text_padding": 0,
                            "text_color": "theme:text.system"
                          },
                          {
                            "id": "body",
                            "kind": "text",
                            "source_id": "UI/classic.roukaku/body",
                            "value": "$item.text_key",
                            "min_width": 268,
                            "max_width": 268,
                            "font_size": 20,
                            "max_lines": 1,
                            "text_padding": 1,
                            "text_color": "theme:text.system"
                          }
                        ]
                      }
                    ],
                    "events": [
                      {
                        "event": "activate",
                        "action": "vn.choose",
                        "arguments": {
                          "option_id": "$item.option_id"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.tsui.classic.title",
      "source_id": "ui.tsui.classic.title",
      "model": "roukaku.vn.ui_model.title.v1",
      "theme": "tsui.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/classic.roukaku/root",
        "background": "theme:surface.sky",
