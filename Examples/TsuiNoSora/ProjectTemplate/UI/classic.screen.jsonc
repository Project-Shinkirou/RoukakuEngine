            "min_height": 64,
            "background": "theme:surface.clear",
            "events": [
              {
                "event": "activate",
                "action": "vn.invoke_system_action",
                "arguments": {
                  "action_id": "tsui.classic.test.open"
                }
              }
            ]
          },
          {
            "id": "start",
            "kind": "button",
            "source_id": "UI/classic.roukaku/start",
            "enabled": "$model.can_continue",
            "position_x": 564,
            "position_y": 344,
            "min_width": 208,
            "min_height": 64,
