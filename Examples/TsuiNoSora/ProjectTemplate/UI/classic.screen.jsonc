              {
                "id": "load_image",
                "kind": "image",
                "source_id": "UI/classic.roukaku/load_image",
                "asset": "theme:menu.continue",
                "min_width": 208,
                "min_height": 64
              }
            ],
            "events": [
              {
                "event": "activate",
                "action": "vn.open_system",
                "arguments": {
                  "page": "load"
                }
              }
            ]
          },
          {
            "id": "exit",
            "kind": "button",
            "source_id": "UI/classic.roukaku/exit",
            "position_x": 564,
            "position_y": 520,
            "min_width": 208,
            "min_height": 64,
