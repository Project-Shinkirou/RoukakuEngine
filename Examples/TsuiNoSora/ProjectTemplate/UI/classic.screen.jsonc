{
  "$schema": "https://project-shinkirou.github.io/schemas/ui-screen.v1.json",
  "views": [
    {
      "id": "ui.tsui.classic.message",
      "source_id": "ui.tsui.classic.message",
      "model": "roukaku.vn.ui_model.message.v2",
      "theme": "tsui.theme.classic",
      "root": {
        "id": "root",
        "kind": "screen",
        "source_id": "UI/classic.roukaku/root",
        "children": [
          {
            "id": "advance",
            "kind": "panel",
            "source_id": "UI/classic.roukaku/advance",
            "fill": true,
            "events": [
              {
                "event": "activate",
                "action": "vn.advance"
              }
            ]
          },
          {
            "id": "dialogue_frame",
            "kind": "image",
            "source_id": "UI/classic.roukaku/dialogue_frame",
            "asset": "theme:dialogue.frame",
            "min_width": 754,
            "min_height": 82,
            "position_x": 23,
            "position_y": 483
          },
          {
            "id": "dialogue",
            "kind": "row",
            "source_id": "UI/classic.roukaku/dialogue",
            "position_x": 56,
            "position_y": 484,
            "min_width": 688,
            "max_width": 688,
            "max_height": 80,
            "gap": 18,
            "clip_children": true,
            "children": [
              {
                "id": "speaker_text",
                "kind": "text",
                "source_id": "UI/classic.roukaku/speaker_text",
                "value": "$model.speaker_key",
                "min_width": 92,
                "max_width": 92,
                "max_height": 72,
                "font_size": 20,
                "max_lines": 2
              },
              {
                "id": "body_scroll",
                "kind": "scroll",
                "source_id": "UI/classic.roukaku/body_scroll",
                "min_width": 578,
                "max_width": 578,
                "min_height": 72,
                "max_height": 72,
                "clip_children": true,
                "children": [
                  {
                    "id": "body",
                    "kind": "text",
                    "source_id": "UI/classic.roukaku/body",
                    "value": "$model.text_key",
                    "visible_graphemes": "$model.visible_graphemes",
                    "max_width": 562,
                    "font_size": 22,
                    "max_lines": 64,
                    "text_padding": 0
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ui.tsui.classic.monologue",
